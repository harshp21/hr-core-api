              "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"department\": \"Platform\",\n  \"country\": \"India\",\n  \"salary\": 70000,\n  \"jobTitle\": \"Senior Software Engineer\",\n  \"currency\": \"INR\",\n  \"employmentType\": \"FULL_TIME\",\n  \"dateOfJoining\": \"2024-01-01\"\n}"
