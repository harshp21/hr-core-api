      "item": [
        {
          "name": "Create Employee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeCode\": \"EMP001\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"department\": \"Engineering\",\n  \"country\": \"India\",\n  \"salary\": 50000,\n  \"jobTitle\": \"Software Engineer\",\n  \"currency\": \"INR\",\n  \"employmentType\": \"FULL_TIME\",\n  \"dateOfJoining\": \"2024-01-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/employees",
